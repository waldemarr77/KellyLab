SECRET_KEY=local-development-only-change-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
USE_SQLITE=true
DB_NAME=kellylab
DB_USER=kellylab
