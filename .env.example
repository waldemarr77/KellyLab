SECRET_KEY=local-development-only-change-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
USE_SQLITE=true
DB_NAME=kellylab
DB_USER=kellylab
DB_PASSWORD=kellylab-local
DB_HOST=127.0.0.1
DB_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=true
# Request limits per user, in DRF format: N/second, N/minute, N/hour, N/day.
AUTH_THROTTLE_RATE=10/minute
GENERATE_THROTTLE_RATE=2/minute
TOKEN_THROTTLE_RATE=30/minute
# Creating sessions and importing questions, per user.
SESSION_WRITE_THROTTLE_RATE=60/hour
# Repeated verification letters, per user.
VERIFICATION_EMAIL_THROTTLE_RATE=3/hour
# Sessions one user can keep (each holds up to 50 questions).
MAX_SESSIONS_PER_USER=50
# Failed logins (API and admin) before the next attempts are refused for 15 minutes.
LOGIN_FAILURE_LIMIT_PER_EMAIL=5
LOGIN_FAILURE_LIMIT_PER_IP=20
# Reverse proxies in front of Django (nginx, load balancer). 0 = direct connections, X-Forwarded-For is ignored.
NUM_PROXIES=0
# Redis for throttle counters; required in production. Empty = in-memory cache per process.
CACHE_URL=
# Questions one user can send to Gemini per day (free tier key: 500 requests/day in total).
AI_DAILY_QUESTION_LIMIT=100
# Questions the whole service can send to Gemini per day (resets at 00:00 Pacific time). Keep below the key's 500 RPD.
AI_GLOBAL_DAILY_QUESTION_LIMIT=400
# Output tokens per answer; thinking models spend part of them on reasoning.
AI_MAX_OUTPUT_TOKENS=8192
# Thinking budget in tokens. Empty = model default, 0 = off (where the model allows it).
AI_THINKING_BUDGET=
# Minimum seconds between Gemini requests (free tier: 15 requests/minute -> 4).
AI_MIN_INTERVAL_SECONDS=4
# Required for generation: questions are sent to the Gemini API.
GEMINI_API_KEY=
# Set a model ID available to your Gemini account.
GEMINI_MODEL=
# Exporter service (PDF/DOCX). In Docker it is set by compose.yaml; override there with COMPOSE_EXPORTER_URL.
EXPORTER_URL=http://127.0.0.1:8002
EXPORT_THROTTLE_RATE=10/minute
# SMTP for verification letters. Empty EMAIL_HOST = letters are printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=KellyLab <noreply@localhost>
# Frontend page from the verification letter; it POSTs uid and token to /api/auth/verify-email/.
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email?uid={uid}&token={token}
# Frontend page from the password reset letter; it POSTs uid, token and new_password to /api/auth/password/reset/confirm/.
PASSWORD_RESET_URL=http://localhost:5173/reset-password?uid={uid}&token={token}
