SECRET_KEY=local-development-only-change-before-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=true
DB_NAME=kellylab
DB_USER=kellylab
DB_PASSWORD=kellylab-local
DB_HOST=127.0.0.1
DB_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=true
# demo emits clearly labelled placeholders; gemini sends questions to Google's API.
AI_BACKEND=demo
GEMINI_API_KEY=
# Set a model ID available to your Gemini account.
GEMINI_MODEL=
